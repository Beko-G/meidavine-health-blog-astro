---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
---
<!doctype html>
<html lang="en">
	<head><BaseHead title={`Contact | ${SITE_TITLE}`} description="Contact our editors" /></head>
	<body>
		<Header />
		<main style="max-width: 720px; margin: 0 auto; padding: 2em 1em;">
			<h1>Contact Information</h1>
			<p>For press inquiries, editorial corrections, or scientific submissions, reach out directly:</p>
			<p><strong>Editorial Desk:</strong> editor@yourdomain.com</p>
		</main>
		<Footer />
	</body>
</html>
