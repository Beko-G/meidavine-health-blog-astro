---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const featuredPost = posts[0];
const recentPosts = posts.slice(1, 7);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 960px;
				max-width: calc(100% - 2em);
				margin: 0 auto;
				padding: 2em 1em;
			}
			.hero-card {
				background: #f8fafc;
				border: 1px solid #e2e8f0;
				border-radius: 12px;
				padding: 2.5em;
				margin-bottom: 3em;
			}
			.tag {
				background: #e0f2fe;
				color: #0369a1;
				padding: 0.25em 0.75em;
				border-radius: 99px;
				font-size: 0.8em;
				font-weight: 700;
				text-transform: uppercase;
			}
			.grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
				gap: 1.5em;
			}
			.card {
				border: 1px solid #e2e8f0;
				border-radius: 8px;
				padding: 1.25em;
				background: #fff;
			}
			.card h3 {
				margin: 0.5em 0;
				font-size: 1.2em;
			}
			.card a {
				color: #0f172a;
				text-decoration: none;
			}
			.card a:hover {
				color: #0284c7;
			}
			.date {
				font-size: 0.85em;
				color: #64748b;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			{featuredPost && (
				<section class="hero-card">
					<span class="tag">Latest Lead Story</span>
					<h1 style="margin-top: 0.5em; font-size: 2.2em;">
						<a href={`/blog/${featuredPost.slug}/`} style="color: #0f172a; text-decoration: none;">
							{featuredPost.data.title}
						</a>
					</h1>
					<p style="color: #475569; font-size: 1.1em; margin-bottom: 1.5em;">
						{featuredPost.data.description}
					</p>
					<a href={`/blog/${featuredPost.slug}/`} style="background: #0284c7; color: white; padding: 0.6em 1.2em; border-radius: 6px; text-decoration: none; font-weight: 600;">
						Read Full Study Breakdown &rarr;
					</a>
				</section>
			)}

			<section>
				<h2 style="border-bottom: 2px solid #0284c7; display: inline-block; padding-bottom: 0.2em; margin-bottom: 1em;">
					Daily Health & Science Coverage
				</h2>
				<div class="grid">
					{recentPosts.map((post) => (
						<article class="card">
							<p class="date">{post.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</p>
							<h3>
								<a href={`/blog/${post.slug}/`}>{post.data.title}</a>
							</h3>
							<p style="font-size: 0.9em; color: #64748b;">{post.data.description}</p>
						</article>
					))}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
