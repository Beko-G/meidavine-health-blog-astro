---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			:root {
				--bg-root: #1a222d;
				--bg-raised: #212b38;
				--bg-raised-hover: #283443;
				--border: rgba(206, 220, 235, 0.12);
				--border-strong: rgba(206, 220, 235, 0.22);
				--text-main: #e9eef4;
				--text-body: #c3cedb;
				--text-muted: #92a1b3;
				--accent: #7fd6c2;
				--accent-strong: #a6e8d8;
				--accent-soft: rgba(127, 214, 194, 0.12);
				--serif: 'Iowan Old Style', 'Palatino Linotype', Palatino, Georgia, 'Times New Roman', serif;
				--sans: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
			}

			*, *::before, *::after {
				box-sizing: border-box;
			}

			body {
				background-color: var(--bg-root);
				background-image: linear-gradient(180deg, #202a37 0%, var(--bg-root) 520px);
				background-repeat: no-repeat;
				color: var(--text-main);
				font-family: var(--sans);
				margin: 0;
				padding: 0;
				-webkit-font-smoothing: antialiased;
			}

			main {
				width: 1100px;
				max-width: calc(100% - 2rem);
				margin: 0 auto;
				padding: 4rem 0 5rem;
			}

			a:focus-visible {
				outline: 2px solid var(--accent);
				outline-offset: 3px;
				border-radius: 4px;
			}

			/* Hero */
			.hero-section {
				display: grid;
				grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.65fr);
				gap: 4rem;
				align-items: end;
				padding: 1rem 0 4rem;
				margin-bottom: 3.5rem;
				border-bottom: 1px solid var(--border);
			}

			@media (max-width: 850px) {
				.hero-section {
					grid-template-columns: 1fr;
					gap: 2.5rem;
					padding-bottom: 3rem;
				}
			}

			.badge {
				display: inline-flex;
				align-items: center;
				gap: 0.55rem;
				color: var(--accent);
				font-size: 0.9rem;
				font-weight: 500;
				margin-bottom: 1.5rem;
			}

			.badge-dot {
				width: 8px;
				height: 8px;
				background: var(--accent);
				border-radius: 50%;
				box-shadow: 0 0 0 4px var(--accent-soft);
			}

			.hero-title {
				font-family: var(--serif);
				font-size: clamp(2.5rem, 5.4vw, 4rem);
				font-weight: 600;
				line-height: 1.08;
				letter-spacing: -0.025em;
				margin: 0 0 1.5rem 0;
				max-width: 15ch;
			}

			.hero-desc {
				color: var(--text-body);
				font-size: 1.15rem;
				line-height: 1.7;
				max-width: 52ch;
				margin: 0 0 2.25rem 0;
			}

			.btn-action {
				display: inline-flex;
				align-items: center;
				gap: 0.5rem;
				background: var(--accent);
				color: #10231f;
				padding: 0.8rem 1.5rem;
				border-radius: 999px;
				font-weight: 600;
				font-size: 0.95rem;
				text-decoration: none;
				transition: background-color 0.2s ease;
			}

			.btn-action:hover {
				background: var(--accent-strong);
			}

			/* Standards panel */
			.hero-graphic {
				display: flex;
				flex-direction: column;
				gap: 0;
				background: var(--bg-raised);
				border: 1px solid var(--border);
				border-radius: 20px;
				padding: 0.5rem 1.5rem;
			}

			.panel-title {
				font-family: var(--serif);
				font-size: 1.05rem;
				font-weight: 600;
				color: var(--text-main);
				padding: 1.1rem 0 0.9rem;
				border-bottom: 1px solid var(--border);
			}

			.graphic-row {
				display: flex;
				flex-direction: column;
				gap: 0.2rem;
				padding: 1rem 0;
				border-bottom: 1px solid var(--border);
				font-size: 0.85rem;
				color: var(--text-muted);
			}

			.graphic-row:last-child {
				border-bottom: none;
			}

			.metric-value {
				color: var(--text-main);
				font-weight: 600;
				font-size: 1rem;
			}

			.metric-value.is-verified {
				color: var(--accent);
			}

			/* Section header */
			.section-header {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				margin-bottom: 1.75rem;
			}

			.section-title {
				font-family: var(--serif);
				font-size: 1.75rem;
				font-weight: 600;
				letter-spacing: -0.015em;
				color: var(--text-main);
			}

			/* Feed */
			.grid {
				display: grid;
				grid-template-columns: repeat(3, minmax(0, 1fr));
				gap: 1.25rem;
			}

			@media (max-width: 980px) {
				.grid {
					grid-template-columns: repeat(2, minmax(0, 1fr));
				}
			}

			@media (max-width: 640px) {
				.grid {
					grid-template-columns: 1fr;
				}
			}

			.card {
				background: var(--bg-raised);
				border: 1px solid var(--border);
				border-radius: 16px;
				padding: 1.75rem;
				display: flex;
				flex-direction: column;
				position: relative;
				transition: background-color 0.2s ease, border-color 0.2s ease;
			}

			.card:hover,
			.card:focus-within {
				background: var(--bg-raised-hover);
				border-color: var(--border-strong);
			}

			/* Latest post gets the most room */
			.card.featured {
				grid-column: 1 / -1;
				padding: 2.5rem;
				background: linear-gradient(135deg, #263344 0%, var(--bg-raised) 100%);
				border-color: var(--border-strong);
			}

			.card-meta {
				font-size: 0.85rem;
				color: var(--text-muted);
				margin-bottom: 0.9rem;
			}

			.card.featured .card-meta {
				color: var(--accent);
			}

			.card h3 {
				font-family: var(--serif);
				margin: 0 0 0.8rem 0;
				font-size: 1.3rem;
				font-weight: 600;
				line-height: 1.3;
				letter-spacing: -0.01em;
			}

			.card.featured h3 {
				font-size: clamp(1.7rem, 3.2vw, 2.4rem);
				line-height: 1.2;
				max-width: 24ch;
				margin-bottom: 1rem;
			}

			.card h3 a {
				color: var(--text-main);
				text-decoration: none;
			}

			/* Whole card is clickable */
			.card h3 a::after {
				content: '';
				position: absolute;
				inset: 0;
				border-radius: inherit;
			}

			.card:hover h3 a {
				color: var(--accent-strong);
			}

			.card p {
				color: var(--text-body);
				font-size: 0.97rem;
				line-height: 1.65;
				margin: 0;
			}

			.card.featured p {
				font-size: 1.05rem;
				max-width: 62ch;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<!-- Brand Hero Banner with Embedded Graphic -->
			<section class="hero-section">
				<div>
					<div class="badge">
						<span class="badge-dot"></span>
						Evidence-Based Intelligence
					</div>
					<h1 class="hero-title">
						Decoding Clinical Research & Medical Science.
					</h1>
					<p class="hero-desc">
						Rigorous, peer-reviewed health research, clinical trial updates, and medical science breakthroughs translated into clear, actionable daily intelligence.
					</p>
					<a href="/blog" class="btn-action">
						Explore All Briefings &rarr;
					</a>
				</div>

				<div class="hero-graphic">
					<div class="panel-title">System Status & Metrics</div>
					<div class="graphic-row">
						<span>Indexed Journals</span>
						<span class="metric-value">PubMed / Lancet / JAMA</span>
					</div>
					<div class="graphic-row">
						<span>Verification Status</span>
						<span class="metric-value is-verified">100% Peer-Reviewed</span>
					</div>
					<div class="graphic-row">
						<span>Publication Frequency</span>
						<span class="metric-value">Daily Updates</span>
					</div>
				</div>
			</section>

			<!-- Recent Articles Feed -->
			<section>
				<div class="section-header">
					<h2 class="section-title">Latest Research News</h2>
				</div>

				<div class="grid">
					{posts.map((post, i) => (
						<article class={i === 0 ? 'card featured' : 'card'}>
							<div>
								<div class="card-meta">
									<span>{post.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
								</div>
								<h3>
									<a href={`/blog/${post.slug}/`}>{post.data.title}</a>
								</h3>
								<p>{post.data.description}</p>
							</div>
						</article>
					))}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
