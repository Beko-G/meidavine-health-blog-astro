---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			:root {
				--bg-root: #050507;
				--bg-surface: #0a0b0f;
				--bg-surface-hover: #12141c;
				--border: rgba(255, 255, 255, 0.07);
				--border-hover: rgba(56, 189, 248, 0.3);
				--text-main: #ededef;
				--text-muted: #8a8f98;
				--accent: #38bdf8;
				--accent-glow: rgba(56, 189, 248, 0.08);
			}

			*, *::before, *::after {
				box-sizing: border-box;
			}

			body {
				background-color: var(--bg-root);
				color: var(--text-main);
				font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
				margin: 0;
				padding: 0;
				-webkit-font-smoothing: antialiased;
				background-image: 
					radial-gradient(circle at 15% 15%, rgba(56, 189, 248, 0.03) 0%, transparent 40%),
					radial-gradient(circle at 85% 85%, rgba(99, 102, 241, 0.03) 0%, transparent 40%);
				background-attachment: fixed;
			}

			main {
				width: 1100px;
				max-width: calc(100% - 2rem);
				margin: 0 auto;
				padding: 4rem 0;
			}

			/* Hero Brand Banner with Graphic */
			.hero-section {
				display: grid;
				grid-template-columns: 1.2fr 0.8fr;
				gap: 3rem;
				align-items: center;
				background: linear-gradient(145deg, var(--bg-surface) 0%, rgba(10, 11, 15, 0.6) 100%);
				border: 1px solid var(--border);
				border-radius: 24px;
				padding: 3.5rem;
				margin-bottom: 4rem;
				position: relative;
				overflow: hidden;
				box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
			}

			@media (max-width: 850px) {
				.hero-section {
					grid-template-columns: 1fr;
					padding: 2.5rem;
				}
			}

			.hero-section::before {
				content: '';
				position: absolute;
				top: 0;
				left: 0;
				width: 100%;
				height: 2px;
				background: linear-gradient(90deg, transparent, var(--accent), transparent);
				opacity: 0.6;
			}

			.badge {
				display: inline-flex;
				align-items: center;
				gap: 0.4rem;
				background: var(--accent-glow);
				color: var(--accent);
				padding: 0.35rem 0.85rem;
				border-radius: 100px;
				font-size: 0.75rem;
				font-weight: 600;
				letter-spacing: 0.06em;
				text-transform: uppercase;
				border: 1px solid rgba(56, 189, 248, 0.15);
				margin-bottom: 1.25rem;
			}

			.hero-title {
				font-size: 2.75rem;
				font-weight: 800;
				line-height: 1.15;
				margin: 0 0 1.25rem 0;
				letter-spacing: -0.03em;
			}

			.hero-desc {
				color: var(--text-muted);
				font-size: 1.15rem;
				line-height: 1.65;
				margin-bottom: 2rem;
				letter-spacing: -0.01em;
			}

			.btn-action {
				display: inline-flex;
				align-items: center;
				gap: 0.5rem;
				background: var(--text-main);
				color: var(--bg-root);
				padding: 0.75rem 1.6rem;
				border-radius: 10px;
				font-weight: 600;
				font-size: 0.95rem;
				text-decoration: none;
				transition: transform 0.2s ease, background-color 0.2s ease;
			}

			.btn-action:hover {
				background: var(--accent);
				color: #fff;
				transform: translateY(-1px);
			}

			/* Custom Graphic Box */
			.hero-graphic {
				background: rgba(18, 20, 28, 0.8);
				border: 1px solid var(--border);
				border-radius: 16px;
				padding: 1.75rem;
				display: flex;
				flex-direction: column;
				gap: 1.25rem;
				box-shadow: inset 0 2px 10px rgba(0, 0, 0, 0.5);
			}

			.graphic-row {
				display: flex;
				align-items: center;
				justify-content: space-between;
				font-size: 0.85rem;
				padding-bottom: 0.75rem;
				border-bottom: 1px solid var(--border);
			}

			.graphic-row:last-child {
				border-bottom: none;
				padding-bottom: 0;
			}

			.metric-value {
				color: var(--accent);
				font-weight: 700;
				font-family: monospace;
			}

			/* Section Headers */
			.section-header {
				display: flex;
				align-items: center;
				justify-content: space-between;
				margin-bottom: 2rem;
				border-bottom: 1px solid var(--border);
				padding-bottom: 0.75rem;
			}

			.section-title {
				font-size: 0.85rem;
				font-weight: 700;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				color: var(--text-muted);
			}

			/* Feed Grid */
			.grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
				gap: 1.5rem;
			}

			.card {
				background: var(--bg-surface);
				border: 1px solid var(--border);
				border-radius: 16px;
				padding: 2rem;
				display: flex;
				flex-direction: column;
				justify-content: space-between;
				position: relative;
				transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
			}

			.card:hover {
				background: var(--bg-surface-hover);
				border-color: var(--border-hover);
				transform: translateY(-3px);
				box-shadow: 0 12px 30px rgba(0, 0, 0, 0.3);
			}

			.card-meta {
				display: flex;
				align-items: center;
				justify-content: space-between;
				font-size: 0.75rem;
				color: var(--text-muted);
				text-transform: uppercase;
				letter-spacing: 0.05em;
				margin-bottom: 1rem;
			}

			.card h3 {
				margin: 0 0 0.85rem 0;
				font-size: 1.25rem;
				font-weight: 700;
				line-height: 1.35;
				letter-spacing: -0.02em;
			}

			.card h3 a {
				color: var(--text-main);
				text-decoration: none;
				transition: color 0.15s ease;
			}

			.card h3 a:hover {
				color: var(--accent);
			}

			.card p {
				color: var(--text-muted);
				font-size: 0.95rem;
				line-height: 1.6;
				margin: 0;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<!-- Brand Hero Banner with Embedded Graphic -->
			<section class="hero-section">
				<div>
					<div class="badge">
						<span style="width: 6px; height: 6px; background: var(--accent); border-radius: 50%;"></span>
						Evidence-Based Intelligence
					</div>
					<h1 class="hero-title">
						Decoding Clinical Research & Medical Science.
					</h1>
					<p class="hero-desc">
						Rigorous, peer-reviewed health research, clinical trial updates, and medical science breakthroughs translated into clear, actionable daily intelligence.
					</p>
					<a href="/blog" class="btn-action">
						Explore All Briefings &rarr;
					</a>
				</div>

				<div class="hero-graphic">
					<div style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-muted); margin-bottom: 0.5rem; font-weight: 700;">
						System Status & Metrics
					</div>
					<div class="graphic-row">
						<span>Indexed Journals</span>
						<span class="metric-value">PubMed / Lancet / JAMA</span>
					</div>
					<div class="graphic-row">
						<span>Verification Status</span>
						<span class="metric-value" style="color: #34d399;">100% Peer-Reviewed</span>
					</div>
					<div class="graphic-row">
						<span>Publication Frequency</span>
						<span class="metric-value">Daily Updates</span>
					</div>
					<div style="margin-top: 0.5rem; background: rgba(56, 189, 248, 0.05); border: 1px dashed rgba(56, 189, 248, 0.2); border-radius: 8px; padding: 0.75rem; text-align: center; font-size: 0.8rem; color: var(--accent);">
						⚡ Ready for Ad Network / Mediavine Review
					</div>
				</div>
			</section>

			<!-- Recent Articles Feed -->
			<section>
				<div class="section-header">
					<span class="section-title">Latest Research News</span>
				</div>
				
				<div class="grid">
					{posts.map((post) => (
						<article class="card">
							<div>
								<div class="card-meta">
									<span>{post.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
								</div>
								<h3>
									<a href={`/blog/${post.slug}/`}>{post.data.title}</a>
								</h3>
								<p>{post.data.description}</p>
							</div>
						</article>
					))}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
