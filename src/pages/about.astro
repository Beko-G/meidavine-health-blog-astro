---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
---
<!doctype html>
<html lang="en">
	<head><BaseHead title={`About | ${SITE_TITLE}`} description="About our publication" /></head>
	<body>
		<Header />
		<main style="max-width: 720px; margin: 0 auto; padding: 2em 1em;">
			<h1>About Our Publication</h1>
			<p>We break down daily peer-reviewed health research, clinical trial findings, and scientific journal publications into accessible summaries.</p>
			<h2>Editorial Standards</h2>
			<p>Every report references published primary research papers or statements from global health authorities.</p>
		</main>
		<Footer />
	</body>
</html>
