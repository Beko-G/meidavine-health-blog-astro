---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';

const lastUpdated = new Date().toLocaleDateString('en-US', {
	month: 'long',
	day: 'numeric',
	year: 'numeric'
});
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Terms of Service | ${SITE_TITLE}`} description="Terms of Service governing the use of Daily Health News and its content." />
		<style>
			:root {
				--bg-root: #1a222d;
				--bg-raised: #212b38;
				--border: rgba(206, 220, 235, 0.12);
				--border-strong: rgba(206, 220, 235, 0.22);
				--text-main: #e9eef4;
				--text-body: #c3cedb;
				--text-muted: #92a1b3;
				--accent: #7fd6c2;
				--accent-strong: #a6e8d8;
				--accent-soft: rgba(127, 214, 194, 0.12);
				--serif: 'Iowan Old Style', 'Palatino Linotype', Palatino, Georgia, 'Times New Roman', serif;
				--sans: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
			}

			*, *::before, *::after {
				box-sizing: border-box;
			}

			body {
				background-color: var(--bg-root);
				background-image: linear-gradient(180deg, #202a37 0%, var(--bg-root) 520px);
				background-repeat: no-repeat;
				color: var(--text-main);
				font-family: var(--sans);
				margin: 0;
				padding: 0;
				-webkit-font-smoothing: antialiased;
			}

			main {
				width: 840px;
				max-width: calc(100% - 2rem);
				margin: 0 auto;
				padding: 4rem 0 6rem;
			}

			.page-header {
				margin-bottom: 3rem;
				padding-bottom: 2rem;
				border-bottom: 1px solid var(--border);
			}

			.badge {
				display: inline-flex;
				align-items: center;
				gap: 0.55rem;
				color: var(--accent);
				font-size: 0.9rem;
				font-weight: 500;
				margin-bottom: 1rem;
			}

			.badge-dot {
				width: 8px;
				height: 8px;
				background: var(--accent);
				border-radius: 50%;
				box-shadow: 0 0 0 4px var(--accent-soft);
			}

			h1 {
				font-family: var(--serif);
				font-size: clamp(2.2rem, 4.5vw, 3.2rem);
				font-weight: 600;
				line-height: 1.15;
				letter-spacing: -0.025em;
				margin: 0 0 0.8rem 0;
				color: var(--accent);
			}

			.last-updated {
				font-size: 0.9rem;
				color: var(--text-muted);
			}

			.legal-card {
				background: var(--bg-raised);
				border: 1px solid var(--border);
				border-radius: 16px;
				padding: 2.5rem;
				margin-bottom: 2.5rem;
			}

			h2 {
				font-family: var(--serif);
				font-size: 1.5rem;
				font-weight: 600;
				color: var(--text-main);
				margin: 2rem 0 1rem 0;
				letter-spacing: -0.015em;
			}

			.legal-card h2:first-child {
				margin-top: 0;
			}

			p {
				color: var(--text-body);
				font-size: 1rem;
				line-height: 1.75;
				margin: 0 0 1.25rem 0;
			}

			ul {
				color: var(--text-body);
				font-size: 1rem;
				line-height: 1.75;
				margin: 0 0 1.25rem 1.5rem;
				padding: 0;
			}

			li {
				margin-bottom: 0.5rem;
			}

			a {
				color: var(--accent);
				text-decoration: none;
			}

			a:hover {
				color: var(--accent-strong);
				text-decoration: underline;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="page-header">
				<div class="badge">
					<span class="badge-dot"></span>
					Legal Agreements
				</div>
				<h1>Terms of Service</h1>
				<div class="last-updated">Last Updated: {lastUpdated}</div>
			</div>

			<div class="legal-card">
				<h2>1. Acceptance of Terms</h2>
				<p>
					By accessing and browsing {SITE_TITLE} (the "Website"), you agree to comply with and be bound by these Terms of Service. If you do not agree with any part of these terms, please discontinue your use of our publication immediately.
				</p>
			</div>

			<div class="legal-card">
				<h2>2. Medical Disclaimer</h2>
				<p>
					<strong>The content published on {SITE_TITLE} is for informational, educational, and news reporting purposes only.</strong> We report on peer-reviewed clinical studies, medical research, and health science developments.
				</p>
				<p>
					Nothing published on this website constitutes professional medical advice, diagnosis, or treatment. Always seek the advice of your physician or other qualified healthcare provider with any questions you may have regarding a medical condition. Never disregard professional medical advice or delay seeking it because of something you have read on this website.
				</p>
			</div>

			<div class="legal-card">
				<h2>3. Intellectual Property Rights</h2>
				<p>
					All text, graphics, editorial layouts, custom formatting, and software code on this Website are the property of {SITE_TITLE} or licensed for our use, protected by international copyright and intellectual property laws.
				</p>
				<p>
					You may view, download, and print pages for your personal, non-commercial use, provided you do not modify or reproduce content without explicit attribution and linking back to our original publication.
				</p>
			</div>

			<div class="legal-card">
				<h2>4. External Links & Third-Party References</h2>
				<p>
					Our briefings frequently link to external websites, scientific journals, and clinical databases (such as PubMed, JAMA, and The Lancet) for reference and verification. We assume no responsibility or liability for the availability, accuracy, or content of those external sites.
				</p>
			</div>

			<div class="legal-card">
				<h2>5. Limitation of Liability</h2>
				<p>
					In no event shall {SITE_TITLE}, its editors, contributors, or partners be liable for any direct, indirect, incidental, consequential, or punitive damages arising out of your access to, use of, or inability to use this website or any content provided herein.
				</p>
			</div>

			<div class="legal-card">
				<h2>6. Changes to Terms</h2>
				<p>
					We reserve the right to modify these Terms of Service at any time. Changes will become effective immediately upon posting to this page. Your continued use of the website following any changes constitutes your acceptance of the revised terms.
				</p>
			</div>

			<div class="legal-card">
				<h2>7. Contact Information</h2>
				<p>
					If you have any questions or concerns regarding these Terms of Service, please reach out to our editorial desk at <a href="mailto:itsbereketab@gmail.com">itsbereketab@gmail.com</a>.
				</p>
			</div>
		</main>
		<Footer />
	</body>
</html>
