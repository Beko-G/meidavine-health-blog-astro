---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
---
<!doctype html>
<html lang="en">
	<head><BaseHead title={`Editorial Policy | ${SITE_TITLE}`} description="Editorial guidelines" /></head>
	<body>
		<Header />
		<main style="max-width: 720px; margin: 0 auto; padding: 2em 1em;">
			<h1>Editorial & Corrections Policy</h1>
			<p>Our coverage reflects primary source literature (PubMed, JAMA, Lancet). Corrections are transparently updated with dates at the bottom of affected posts.</p>
		</main>
		<Footer />
	</body>
</html>
