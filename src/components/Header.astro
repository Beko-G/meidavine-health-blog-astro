---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---

<header style="border-bottom: 1px solid #e2e8f0; background: #fff; position: sticky; top: 0; z-index: 10;">
	<nav style="max-width: 960px; margin: 0 auto; padding: 1em; display: flex; justify-content: space-between; align-items: center;">
		<h2 style="margin: 0; font-size: 1.4em;">
			<a href="/" style="color: #0284c7; text-decoration: none; font-weight: 800;">{SITE_TITLE}</a>
		</h2>
		<div class="internal-links" style="display: flex; gap: 1.2em; font-weight: 600;">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">News Feed</HeaderLink>
			<HeaderLink href="/about">About Us</HeaderLink>
			<HeaderLink href="/contact">Contact</HeaderLink>
		</div>
	</nav>
</header>
