---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={heroImage} type="article" />
		<style>
			:root {
				--bg-root: #1a222d;
				--bg-raised: #212b38;
				--border: rgba(206, 220, 235, 0.12);
				--border-strong: rgba(206, 220, 235, 0.22);
				--text-main: #e9eef4;
				--text-body: #c3cedb;
				--text-muted: #92a1b3;
				--accent: #7fd6c2;
				--accent-strong: #a6e8d8;
				--accent-soft: rgba(127, 214, 194, 0.12);
				--serif: 'Iowan Old Style', 'Palatino Linotype', Palatino, Georgia, 'Times New Roman', serif;
				--sans: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
			}

			*, *::before, *::after {
				box-sizing: border-box;
			}

			body {
				background-color: var(--bg-root);
				background-image: linear-gradient(180deg, #202a37 0%, var(--bg-root) 520px);
				background-repeat: no-repeat;
				color: var(--text-main);
				font-family: var(--sans);
				margin: 0;
				padding: 0;
				-webkit-font-smoothing: antialiased;
			}

			main {
				width: 820px;
				max-width: calc(100% - 2rem);
				margin: 0 auto;
				padding: 3.5rem 0 6rem;
			}

			.article-header {
				margin-bottom: 2.5rem;
				padding-bottom: 2rem;
				border-bottom: 1px solid var(--border);
			}

			.date-badge {
				display: inline-flex;
				align-items: center;
				gap: 0.55rem;
				color: var(--accent);
				font-size: 0.9rem;
				font-weight: 500;
				margin-bottom: 1rem;
			}

			.badge-dot {
				width: 8px;
				height: 8px;
				background: var(--accent);
				border-radius: 50%;
				box-shadow: 0 0 0 4px var(--accent-soft);
			}

			.last-updated {
				font-size: 0.85rem;
				color: var(--text-muted);
				font-style: italic;
				margin-top: 0.25rem;
			}

			h1 {
				font-family: var(--serif);
				font-size: clamp(2.2rem, 4.5vw, 3.2rem);
				font-weight: 600;
				line-height: 1.15;
				letter-spacing: -0.025em;
				margin: 0 0 1.25rem 0;
				color: var(--text-main);
			}

			.hero-image {
				width: 100%;
				margin-bottom: 2.5rem;
			}

			.hero-image img {
				display: block;
				width: 100%;
				max-height: 440px;
				object-fit: cover;
				border-radius: 16px;
				border: 1px solid var(--border);
			}

			/* Markdown Content Styling */
			.prose {
				color: var(--text-body);
				font-size: 1.08rem;
				line-height: 1.8;
			}

			.prose :global(h2) {
				font-family: var(--serif);
				font-size: 1.8rem;
				font-weight: 600;
				color: var(--text-main);
				margin: 2.5rem 0 1rem;
				letter-spacing: -0.015em;
			}

			.prose :global(h3) {
				font-family: var(--serif);
				font-size: 1.4rem;
				font-weight: 600;
				color: var(--accent);
				margin: 2rem 0 0.85rem;
			}

			.prose :global(p) {
				margin-bottom: 1.5rem;
			}

			.prose :global(a) {
				color: var(--accent);
				text-decoration: underline;
				text-underline-offset: 3px;
			}

			.prose :global(a:hover) {
				color: var(--accent-strong);
			}

			.prose :global(blockquote) {
				background: var(--bg-raised);
				border-left: 4px solid var(--accent);
				border-radius: 0 12px 12px 0;
				margin: 2rem 0;
				padding: 1.25rem 1.75rem;
				font-family: var(--serif);
				font-size: 1.15rem;
				color: var(--text-main);
				font-style: italic;
			}

			.prose :global(ul), .prose :global(ol) {
				margin: 0 0 1.5rem 1.5rem;
				padding: 0;
			}

			.prose :global(li) {
				margin-bottom: 0.5rem;
			}

			.prose :global(code) {
				background: var(--bg-raised);
				border: 1px solid var(--border);
				color: var(--accent-strong);
				padding: 0.2rem 0.4rem;
				border-radius: 6px;
				font-size: 0.9em;
			}

			.prose :global(pre) {
				background: var(--bg-raised) !important;
				border: 1px solid var(--border);
				border-radius: 12px;
				padding: 1.25rem;
				overflow-x: auto;
				margin: 2rem 0;
			}

			.prose :global(hr) {
				border: 0;
				border-top: 1px solid var(--border);
				margin: 3rem 0;
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="article-header">
					<div class="date-badge">
						<span class="badge-dot"></span>
						<FormattedDate date={pubDate} />
					</div>
					{
						updatedDate && (
							<div class="last-updated">
								Updated on <FormattedDate date={updatedDate} />
							</div>
						)
					}
					<h1>{title}</h1>
				</div>

				{heroImage && (
					<div class="hero-image">
						<img src={heroImage} alt="" />
					</div>
				)}

				<div class="prose">
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
